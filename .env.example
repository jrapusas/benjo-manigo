# Local dev: omit vars below (Keystatic uses filesystem storage).
# Cloudflare Workers: set in Workers → Settings → Variables and secrets
# (Production + Preview). See README.md § Deployment.

# Workers Builds (dashboard env var, not in .env):
# NODE_VERSION=22

# GitHub App: https://github.com/settings/apps/new
# Homepage URL:    https://YOUR_DOMAIN
# Callback URL:    https://YOUR_DOMAIN/api/keystatic/github/oauth/callback
# Install on repo: your-org/your-repo
# KEYSTATIC_STORAGE=github   # optional; production auto-uses GitHub when repo var is set
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=                          # openssl rand -hex 32
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=          # slug from https://github.com/apps/<slug>

# Not secret - required in production for GitHub-backed CMS
KEYSTATIC_GITHUB_REPO=your-org/benjo-manigo

# Commission inquiry (Cloudflare Worker / Pages)
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=noreply@your-domain.com
