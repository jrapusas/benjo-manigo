---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../config/site';
import type { ContentBlock } from '../lib/types';

Astro.response.status = 404;

const title = `Page not found | ${siteConfig.name}`;
const description = 'The page you are looking for does not exist or may have been moved.';

const blocks: ContentBlock[] = [
  {
    discriminant: 'hero',
    value: {
      eyebrow: '404 · Page not found',
      title: "We couldn't find that page",
      description:
        'The link may be outdated. Head home or browse the gallery.',
      image: '/images/gallery/floral/floral-01-bougainvillea-dew.webp',
      variant: 'splitImageContained',
      appearance: 'dark',
      color: 'auto',
      primaryCta: { label: 'View gallery', url: '/work' },
      secondaryCta: { label: 'Back to home', url: '/' },
    },
  },
];
---

<PageLayout title={title} description={description} blocks={blocks} />
