---
// DYNAMIC ROUTE - file name [slug].astro creates one page per slug (e.g. /about, /contact).
// Astro calls getStaticPaths() at build time to know which slugs to generate.

import { reader } from '../lib/reader';
import PageLayout from '../layouts/PageLayout.astro';
import { resolveMediaSrc } from '../lib/media';
import { buildSeo } from '../lib/seo';

// Must export this function for dynamic routes in static mode.
// Return { params: { slug: 'about' } } for each page to pre-render.
export async function getStaticPaths() {
  const slugs = await reader.collections.pages.list();
  const allowed = new Set(['about']);
  const paths = slugs
    .filter((slug) => slug !== 'home' && allowed.has(slug))
    .map((slug) => ({ params: { slug } }));

  return paths;
}

// Astro.params comes from getStaticPaths - TypeScript knows slug exists but may still be undefined
const { slug } = Astro.params;
const page = await reader.collections.pages.read(slug!, {
  resolveLinkedFiles: true,
});
// slug! - non-null assertion: "I know slug is defined here" (because getStaticPaths provided it)

if (!page) {
  return Astro.redirect('/404'); // early return from frontmatter skips rendering this page
}

const ogImage = await resolveMediaSrc(page.ogImage);

const seo = buildSeo({
  title: page.title,
  path: `/${slug}`,
  seoTitle: page.seoTitle,
  metaDescription: page.metaDescription,
  canonicalUrl: page.canonicalUrl,
  ogTitle: page.ogTitle,
  ogDescription: page.ogDescription,
  ogImage,
});
---

<PageLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  ogTitle={seo.openGraph.title}
  ogDescription={seo.openGraph.description}
  ogImage={seo.openGraph.image}
  blocks={page.blocks}
/>
