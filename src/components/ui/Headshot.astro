---
import MediaImage from './MediaImage.astro';

interface Props {
  src: string;
  alt?: string;
  class?: string;
}

const { src, alt = '', class: className = '' } = Astro.props;
---

<div class:list={['headshot', className]}>
  <MediaImage
    src={src}
    alt={alt}
    widths={[80, 160, 240]}
    sizes="80px"
  />
</div>
