---
import Container from './Container.astro';
import Section from './Section.astro';
import type { BreadcrumbItem } from '../../lib/breadcrumbs';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

{
  items.length > 1 && (
    <Section
      appearance="default"
      padding="none"
      class="section-breadcrumbs border-b border-subtle"
    >
      <Container>
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            {
              items.map((item, index) => {
                const isLast = index === items.length - 1;
                return (
                  <li class="breadcrumb-item">
                    {isLast || !item.href ? (
                      <span class="breadcrumb-current" aria-current="page">{item.label}</span>
                    ) : (
                      <a href={item.href} class="breadcrumb-link">{item.label}</a>
                    )}
                  </li>
                );
              })
            }
          </ol>
        </nav>
      </Container>
    </Section>
  )
}

<style>
  .breadcrumb-nav {
    padding-block: 1rem 1.25rem;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    max-width: 100%;
  }

  .breadcrumb-item:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-muted-fg-subtle, var(--color-subheading));
    pointer-events: none;
  }

  .breadcrumb-link {
    color: var(--color-subheading, var(--color-muted-fg));
    text-decoration: none;
    transition: color 180ms;
  }

  .breadcrumb-link:hover {
    color: var(--color-link);
    text-decoration: underline;
  }

  .breadcrumb-current {
    color: var(--color-heading);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
