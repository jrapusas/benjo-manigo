---
import { siteConfig } from '../../config/site';
import { getResolvedSitePalette, sitePaletteColorId } from '../../lib/sitePalette';
import { isNavActive, isNavItemActive, type NavItem } from '../../lib/navigation';

interface Props {
  companyName: string;
  navigation: NavItem[];
  currentPath: string;
}

const { companyName, navigation, currentPath } = Astro.props;
const sitePalette = getResolvedSitePalette();
const cta = siteConfig.cta.primary;
const navLinks = navigation.filter((item) => item.href !== cta.href);
---

<header
  class="site-header sticky top-0 z-50 border-b border-subtle bg-[color-mix(in_srgb,var(--color-background)_94%,transparent)]"
  style="--site-header-height: 4rem;"
>
  <div class="container-page site-header-inner">
    <a href="/" class="site-name text-base font-bold tracking-tight text-[var(--color-heading)] sm:text-lg">
      <span class="hidden sm:inline">{companyName}</span>
      <span class="sm:hidden">{siteConfig.shortName}</span>
    </a>

    <div class="header-end">
    <nav class="header-nav hidden lg:block" aria-label="Main navigation">
      <ul class="header-nav-list">
        {
          navLinks.map((item) => {
            const hasChildren = Boolean(item.children?.length);
            const active = isNavItemActive(item, currentPath);

            if (!hasChildren) {
              return (
                <li>
                  <a
                    href={item.href}
                    class="link-nav"
                    aria-current={isNavActive(item.href, currentPath) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            }

            return (
              <li class="nav-dropdown">
                <a
                  href={item.href}
                  class="link-nav nav-dropdown-trigger"
                  aria-current={active ? 'page' : undefined}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </a>
                <ul class="nav-dropdown-menu">
                  {
                    item.children?.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="nav-dropdown-link"
                          aria-current={isNavActive(child.href, currentPath) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a href={cta.href} class="header-cta hidden md:inline-flex btn btn-primary">{cta.label}</a>

    <details class="mobile-menu lg:hidden">
      <summary class="mobile-menu-trigger" aria-label="Toggle menu">
        <span class="mobile-menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <div class="mobile-menu-backdrop" aria-hidden="true"></div>
      <div
        class="mobile-menu-panel appearance-section"
        data-color={sitePaletteColorId(sitePalette)}
        data-appearance="soft"
      >
        <nav class="container-page" aria-label="Mobile navigation">
          <ul class="mobile-menu-list">
            {
              navigation.map((item) => {
                const hasChildren = Boolean(item.children?.length);
                const active = isNavItemActive(item, currentPath);

                if (!hasChildren) {
                  return (
                    <li>
                      <a
                        href={item.href}
                        class="mobile-menu-link"
                        aria-current={isNavActive(item.href, currentPath) ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                }

                return (
                  <li>
                    <details class="mobile-submenu" open={active}>
                      <summary class="mobile-submenu-trigger">
                        <span class="mobile-submenu-label">{item.label}</span>
                        <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </summary>
                      <ul class="mobile-submenu-list">
                        <li>
                          <a
                            href={item.href}
                            class="mobile-menu-link mobile-submenu-link"
                            aria-current={isNavActive(item.href, currentPath) ? 'page' : undefined}
                          >
                            All {item.label}
                          </a>
                        </li>
                        {
                          item.children?.map((child) => (
                            <li>
                              <a
                                href={child.href}
                                class="mobile-menu-link mobile-submenu-link"
                                aria-current={isNavActive(child.href, currentPath) ? 'page' : undefined}
                              >
                                {child.label}
                              </a>
                            </li>
                          ))
                        }
                      </ul>
                    </details>
                  </li>
                );
              })
            }
          </ul>
          <div class="mobile-menu-cta">
            <a href={cta.href} class="btn btn-primary mobile-menu-cta-btn">{cta.label}</a>
          </div>
        </nav>
      </div>
    </details>
    </div>
  </div>
</header>

<script>
  import { initMobileMenu } from '../../scripts/mobile-menu.ts';
  import { initNavDropdowns } from '../../scripts/nav-dropdown.ts';

  initMobileMenu();
  initNavDropdowns();
</script>

<style>
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (width >= 64rem) {
    .header-end {
      gap: 1.25rem;
    }
  }

  .header-nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header .link-nav {
    min-height: 2.25rem;
    padding-inline: 0.5rem;
    font-size: 0.8125rem;
  }

  .header-cta {
    min-height: 2.125rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .site-name {
    min-width: 0;
    max-width: min(100%, 14rem);
    text-wrap: balance;
  }

  @media (width >= 40rem) {
    .site-name {
      max-width: min(100%, 18rem);
    }
  }

  @media (width >= 64rem) {
    .site-name {
      max-width: none;
    }
  }

  .nav-dropdown {
    position: relative;
  }

  /* Invisible bridge so moving to the panel does not drop hover. */
  .nav-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -0.5rem;
    right: -0.5rem;
    height: 0.75rem;
  }

  .nav-dropdown-trigger {
    gap: 0.25rem;
  }

  .nav-chevron {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .nav-dropdown:hover .nav-chevron,
  .nav-dropdown:focus-within .nav-chevron,
  .nav-dropdown[data-open] .nav-chevron,
  .mobile-submenu[open] .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 50%;
    z-index: 70;
    min-width: 13rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    border: 1px solid color-mix(in srgb, var(--color-text) 12%, var(--color-background));
    border-radius: var(--radius-xl);
    background-color: var(--color-background);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%);
    pointer-events: none;
    transition:
      opacity 160ms ease,
      visibility 0s linear 160ms;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown[data-open] .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 160ms ease,
      visibility 0s linear 0s;
  }

  .nav-dropdown-link {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-subheading, var(--color-muted-fg));
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 180ms,
      color 180ms;
  }

  .nav-dropdown-link:hover {
    background-color: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    color: var(--color-link);
  }

  .nav-dropdown-link[aria-current='page'] {
    background-color: color-mix(in srgb, var(--color-link) 10%, var(--color-background));
    color: var(--color-link);
    font-weight: 600;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 12%, var(--color-background));
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--color-text) 3%, var(--color-background));
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
    transition:
      background-color 180ms,
      border-color 180ms,
      box-shadow 180ms;
  }

  .mobile-menu-trigger:hover {
    background-color: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
  }

  .mobile-menu-trigger:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .mobile-menu-icon {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.875rem;
  }

  .mobile-menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 9999px;
    background-color: currentColor;
    transition:
      transform 220ms ease,
      opacity 180ms ease,
      top 220ms ease;
  }

  .mobile-menu-icon span:nth-child(1) {
    top: 0;
  }

  .mobile-menu-icon span:nth-child(2) {
    top: 0.375rem;
  }

  .mobile-menu-icon span:nth-child(3) {
    top: 0.75rem;
  }

  .mobile-menu[open] .mobile-menu-icon span:nth-child(1) {
    top: 0.375rem;
    transform: rotate(45deg);
  }

  .mobile-menu[open] .mobile-menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu[open] .mobile-menu-icon span:nth-child(3) {
    top: 0.375rem;
    transform: rotate(-45deg);
  }

  .mobile-menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    top: var(--site-header-height, 4.5rem);
    z-index: 55;
    border: 0;
    background-color: color-mix(in srgb, var(--color-heading) 40%, transparent);
    cursor: pointer;
  }

  .mobile-menu[open] .mobile-menu-backdrop {
    display: block;
  }

  .mobile-menu-panel {
    position: fixed;
    inset-inline: 0;
    top: var(--site-header-height, 4.5rem);
    z-index: 60;
    max-height: calc(100dvh - var(--site-header-height, 4.5rem));
    overflow-y: auto;
    background-color: var(--color-background);
    color: var(--color-text);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, var(--color-background));
    box-shadow: var(--shadow-lg);
    visibility: hidden;
    transform: translateY(-0.5rem);
    pointer-events: none;
    transition:
      visibility 220ms ease,
      transform 220ms ease;
  }

  .mobile-menu[open] .mobile-menu-panel {
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 1rem 0 0.75rem;
    list-style: none;
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-lg);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-subheading, var(--color-muted-fg));
    text-decoration: none;
    transition:
      background-color 180ms,
      color 180ms;
  }

  .mobile-menu-link:hover {
    background-color: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    color: var(--color-link);
  }

  .mobile-menu-link[aria-current='page'] {
    background-color: color-mix(in srgb, var(--color-link) 10%, var(--color-background));
    color: var(--color-link);
    font-weight: 600;
    box-shadow: inset 3px 0 0 var(--color-link);
  }

  .mobile-submenu {
    border-radius: var(--radius-lg);
  }

  .mobile-submenu-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-lg);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
    transition: background-color 180ms;
  }

  .mobile-submenu-trigger::-webkit-details-marker {
    display: none;
  }

  .mobile-submenu-trigger:hover {
    background-color: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
  }

  .mobile-submenu-trigger:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .mobile-submenu-label {
    flex: 1;
    min-width: 0;
  }

  .mobile-submenu-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0 0 0.25rem 0.75rem;
    list-style: none;
  }

  .mobile-submenu-link {
    min-height: 2.5rem;
    padding-inline-start: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-inline-start: 2px solid color-mix(in srgb, var(--color-text) 10%, var(--color-background));
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .mobile-submenu-link[aria-current='page'] {
    border-inline-start-color: var(--color-link);
  }

  .mobile-menu-cta {
    padding: 0.75rem 0 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, var(--color-background));
  }

  .mobile-menu-cta-btn {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-icon span,
    .mobile-menu-panel,
    .nav-dropdown-menu,
    .nav-chevron {
      transition: none;
    }

    .mobile-menu-panel,
    .mobile-menu[open] .mobile-menu-panel,
    .nav-dropdown-menu,
    .nav-dropdown:hover .nav-dropdown-menu,
    .nav-dropdown:focus-within .nav-dropdown-menu,
    .nav-dropdown[data-open] .nav-dropdown-menu {
      transform: translateX(-50%);
    }
  }
</style>
