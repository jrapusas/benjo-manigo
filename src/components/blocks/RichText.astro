---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import DocumentContent from '../react/DocumentContent';
import type { BlockValue } from '../../lib/types';
import { hasDocument } from '../../lib/blockFields';

interface Props extends BlockValue<'richText'> {}

const { color, appearance, content } = Astro.props;
const templateClass = 'section-rich-text';
---

{
  hasDocument(content) && (
    <Section color={color} appearance={appearance ?? 'default'} class={templateClass}>
      <Container narrow>
        <div class="prose-content max-w-none">
          <DocumentContent document={content} />
        </div>
      </Container>
    </Section>
  )
}
