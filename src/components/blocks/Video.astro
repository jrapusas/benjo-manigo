---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import BlockHeader from '../ui/BlockHeader.astro';
import MediaImage from '../ui/MediaImage.astro';
import type { BlockValue } from '../../lib/types';
import { hasText } from '../../lib/blockFields';
import { videoEmbedSrc, videoPosterUrl } from '../../lib/videoEmbed';

interface Props extends BlockValue<'video'> {}

const { color, appearance, heading, description, url, image, imageAlt = '' } = Astro.props;
const templateClass = 'section-video';
const src = hasText(url) ? videoEmbedSrc(url) : null;
const poster =
  (hasText(image) ? image : null) ??
  (src && hasText(url) ? await videoPosterUrl(url) : null);
const posterAlt = hasText(image) ? imageAlt.trim() : '';
const videoTitle = heading ?? 'Video';
---

<Section color={color} appearance={appearance ?? 'soft'} class={templateClass}>
  <Container class="max-w-4xl">
    <BlockHeader heading={heading} description={description} class="mb-stack-8" />
    {
      src ? (
        <div
          class="video-facade media-frame aspect-video"
          data-video-facade
          data-embed-src={src}
          data-video-title={videoTitle}

        >
          <button
            type="button"
            class:list={['video-facade__trigger', { 'video-facade__trigger--no-poster': !poster }]}
            data-video-facade-trigger
            aria-label={`Play video: ${videoTitle}`}
          >
            {
              poster ? (
                <MediaImage
                  src={poster}
                  alt={posterAlt}
                  class="video-facade__poster"
                  sizes="(min-width: 768px) 56rem, 100vw"
                />
              ) : null
            }
            <span class="video-facade__play" aria-hidden="true">
              <svg viewBox="0 0 80 80" width="80" height="80" focusable="false">
                <circle class="video-facade__play-bg" cx="40" cy="40" r="40"></circle>
                <path class="video-facade__play-icon" d="M34 26l24 14-24 14z"></path>
              </svg>
            </span>
          </button>
        </div>
      ) : (
        <p
          class="card block-card text-center text-muted"

        >
          Unable to embed this video URL. Please use a YouTube or Vimeo link.
        </p>
      )
    }
  </Container>
</Section>

{
  src ? (
    <script>
      import { initVideoFacades } from '../../scripts/video-facade.ts';

      initVideoFacades();
    </script>
  ) : null
}

<style>
  .video-facade {
    position: relative;
    background-color: color-mix(in srgb, var(--color-text) 8%, var(--color-background));
  }

  .video-facade__trigger {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: transparent;
    color: inherit;
  }

  .video-facade__trigger:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: -2px;
  }

  .video-facade__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-facade__trigger--no-poster {
    min-height: 100%;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-text) 14%, var(--color-background)),
      color-mix(in srgb, var(--color-text) 6%, var(--color-background))
    );
  }

  .video-facade__play {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }

  .video-facade__trigger:hover .video-facade__play,
  .video-facade__trigger:focus-visible .video-facade__play {
    transform: scale(1.06);
  }

  .video-facade__play-bg {
    fill: var(--color-button-bg);
  }

  .video-facade__play-icon {
    fill: var(--color-button-text, var(--color-button-fg));
  }
</style>
