---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import BlockHeader from '../ui/BlockHeader.astro';
import ContentSlider from '../ui/ContentSlider.astro';
import ClientLogo from '../ui/ClientLogo.astro';
import type { BlockValue } from '../../lib/types';
import { hasText, isSliderVariant } from '../../lib/blockFields';

interface Props extends BlockValue<'logoGrid'> {}

const {
  color,
  appearance,
  heading,
  description,
  variant,
  logos = [],
  disclosure,
} = Astro.props;
const visibleLogos = logos.filter((logo) => hasText(logo.name));
const isSlider = isSliderVariant(variant);
const templateClass = isSlider ? 'section-logogrid-slider' : 'section-logogrid';
const disclosureNote =
  disclosure ??
  'Company marks shown are fictional specimens used for layout demonstration - not verified client endorsements.';
---

<Section color={color} appearance={appearance ?? 'soft'} class={templateClass}>
  <Container>
    <BlockHeader heading={heading} description={description} />
    {
      isSlider ? (
        <ContentSlider cols={4} label={heading || 'Client logos'}>
          {
            visibleLogos.map((logo) => (
              <div class="logo-grid-cell group flex w-full flex-col items-center justify-center gap-stack-2 text-center">
                {logo.image && (
                  <div class="logo-grid-mark flex w-full items-center justify-center">
                    {
                      logo.url ? (
                        <a
                          href={logo.url}
                          class="logo-grid-link inline-flex items-center justify-center text-muted-subtle transition-colors duration-200 group-hover:text-muted"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <ClientLogo
                            src={logo.image}
                            name={logo.name}
                            class="h-10 w-auto max-w-full sm:h-11"
                          />
                        </a>
                      ) : (
                        <ClientLogo
                          src={logo.image}
                          name={logo.name}
                          class="h-10 w-auto max-w-full text-muted-subtle transition-colors duration-200 group-hover:text-muted sm:h-11"
                        />
                      )
                    }
                  </div>
                )}
                <p class="sr-only">{logo.name}</p>
              </div>
            ))
          }
        </ContentSlider>
      ) : (
        <div class="item-grid item-grid-cols-4">
          {
            visibleLogos.map((logo) => (
              <div class="logo-grid-cell group flex w-full flex-col items-center justify-center gap-stack-2 text-center">
                {logo.image && (
                  <div class="logo-grid-mark flex w-full items-center justify-center">
                    {
                      logo.url ? (
                        <a
                          href={logo.url}
                          class="logo-grid-link inline-flex items-center justify-center text-muted-subtle transition-colors duration-200 group-hover:text-muted"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <ClientLogo
                            src={logo.image}
                            name={logo.name}
                            class="h-10 w-auto max-w-full sm:h-11"
                          />
                        </a>
                      ) : (
                        <ClientLogo
                          src={logo.image}
                          name={logo.name}
                          class="h-10 w-auto max-w-full text-muted-subtle transition-colors duration-200 group-hover:text-muted sm:h-11"
                        />
                      )
                    }
                  </div>
                )}
                <p class="sr-only">{logo.name}</p>
              </div>
            ))
          }
        </div>
      )
    }
    <p class="mt-stack-8 text-center block-caption text-muted-subtle">{disclosureNote}</p>
  </Container>
</Section>

<style>
  .logo-grid-cell {
    min-height: 5.5rem;
    padding: 1.25rem 1rem;
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, var(--color-background));
    background-color: color-mix(in srgb, var(--color-text) 2%, var(--color-background));
    transition:
      border-color 200ms var(--ease-out-expo),
      background-color 200ms var(--ease-out-expo),
      box-shadow 200ms var(--ease-out-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .logo-grid-cell:hover {
      border-color: color-mix(in srgb, var(--color-text) 14%, var(--color-background));
      background-color: color-mix(in srgb, var(--color-text) 4%, var(--color-background));
      box-shadow: var(--shadow-sm);
    }
  }

  .logo-grid-mark {
    min-height: 2.75rem;
    width: 100%;
  }

  .logo-grid-link,
  .logo-grid-mark :global(svg),
  .logo-grid-mark :global(img) {
    display: block;
    margin-inline: auto;
  }
</style>
