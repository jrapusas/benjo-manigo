{
  "name": "benjo-manigo",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate:colors && node scripts/stop-astro-dev.mjs && node scripts/clear-vite-cache.mjs && astro dev",
    "dev:fresh": "node scripts/stop-astro-dev.mjs && node scripts/clear-vite-cache.mjs && astro dev --background --host",
    "build": "vite-node scripts/generate-color-themes.mjs && astro build && node scripts/strip-pages-output-dir.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build",
    "generate:colors": "vite-node scripts/generate-color-themes.mjs",
    "content:apply-template": "node scripts/content-templates.mjs apply-template",
    "content:list-templates": "node scripts/content-templates.mjs list-templates",
    "content:seed-media": "node scripts/seed-media.mjs",
    "content:seed-icons": "vite-node scripts/seed-icon-files.mjs",
    "content:media-prompts": "node scripts/add-media-prompts.mjs",
    "content:refresh-media": "node scripts/refresh-unsplash-media.mjs",
    "gallery:sync": "node scripts/sync-gallery-from-brain.mjs",
    "gallery:deframe-portraits": "node scripts/deframe-portraits.mjs",
    "gallery:deframe-batch": "node scripts/deframe-gallery-batch.mjs",
    "gallery:deframe-christian": "node scripts/deframe-christian.mjs",
    "content:image-brief": "node scripts/generate-image-brief.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/markdoc": "^2.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/utils": "^3.1.7",
    "@keystar/ui": "~0.10.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.131.0"
  },
  "devDependencies": {
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
